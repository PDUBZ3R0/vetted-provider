{
  "name": "vetted-provider",
  "version": "0.1.0",
  "description": "Rate every public RPC for an EVM chain (getLogs limits, revert data, gas cap, rate limits, latency, WebSocket health) and pick the best one for the job.",
  "type": "module",
  "bin": {
    "vetrpc": "./dist/cli.js"
  },
  "scripts": {
    "vet": "bash ./vet.sh",
    "best": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts best",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning test/mock.test.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning test/provider.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=22.6"
  },
  "license": "MIT",
  "keywords": [
    "ethereum",
    "evm",
    "rpc",
    "json-rpc",
    "chainlist",
    "ethers",
    "getLogs"
  ],
  "devDependencies": {
    "ethers": "^6.13.4",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "ethers": "^6.13.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts"
}
